generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum RoleName {
  ADMIN
  RMG
  DELIVERY
  HR
  TA
  VIEWER
}

enum ResourceStatus {
  AVAILABLE
  ALLOCATED
  BENCH_COMMITTED
  BENCH_TRUE
  ON_ML
  TERMINATED
}

enum AllocationStatus {
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum ImportRecordStatus {
  CREATED
  UPDATED
  QUARANTINED
}

enum ImportBatchStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum TerminationStatus {
  PENDING_HR_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum ApprovalStatus {
  PENDING_HR_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum DemandStage {
  DRAFT
  PIPELINE
  COMMITTED
  FULFILLED
  CANCELLED
}

enum NotificationType {
  REALLOCATION
  BENCH_AGING
  TERMINATION
  TERMINATION_APPROVAL_NEEDED
  ML_APPROVAL_NEEDED
  IMPORT_QUARANTINE
  BLOCKED_ACTION
  UNMET_DEMAND
  DEMAND_RAISED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// ---------- Core access-control models ----------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          RoleName
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  portfolioAuthorizations PortfolioAuthorization[] @relation("UserAuthorizations")
  grantedAuthorizations   PortfolioAuthorization[] @relation("GrantedBy")
  createdAllocations      Allocation[]              @relation("AllocationCreatedBy")
  ownedDemandRequests     DemandRequest[]           @relation("DemandOwner")
  createdDemandRequests   DemandRequest[]           @relation("DemandCreatedBy")
  updatedDemandRequests   DemandRequest[]           @relation("DemandUpdatedBy")
  auditLogs               AuditLog[]
  notifications           Notification[]
  initiatedTerminations   TerminationRequest[]      @relation("TerminationInitiator")
  decidedTerminations     TerminationRequest[]      @relation("TerminationApprover")
  initiatedMlRequests     MaternityLeaveRequest[]   @relation("MlInitiator")
  decidedMlRequests       MaternityLeaveRequest[]   @relation("MlApprover")
}

model Portfolio {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  managerName String?
  createdAt DateTime @default(now())

  resources       Resource[]
  projects        Project[]
  authorizations  PortfolioAuthorization[]
  demandRequests  DemandRequest[]
  benchConfig     BenchConfig?
  allocations     Allocation[] @relation("AllocationPortfolio")
}

model PortfolioAuthorization {
  id          String    @id @default(uuid())
  userId      String
  portfolioId String
  isActive    Boolean   @default(true)
  grantedById String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  user      User      @relation("UserAuthorizations", fields: [userId], references: [id])
  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  grantedBy User?     @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, portfolioId])
}

// ---------- Resource repository ----------

model Resource {
  id               String         @id @default(uuid())
  employeeId       String         @unique
  name             String
  email            String
  gender           Gender           @default(UNDISCLOSED)
  country          String?
  workLocation     String?
  location         String
  willingToRelocate Boolean       @default(false)
  costRate         Decimal        @db.Decimal(10, 2)
  currency         String         @default("USD")
  portfolioId      String
  managerName      String?
  designation      String?
  subCategory      String?
  dateOfJoining    DateTime?
  priorExperienceYears Float      @default(0)
  status           ResourceStatus @default(AVAILABLE)
  benchSince       DateTime?
  sourceSystem     String         @default("MANUAL")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  portfolio         Portfolio           @relation(fields: [portfolioId], references: [id])
  skills            ResourceSkill[]
  certifications    Certification[]
  performanceRecords PerformanceRecord[]
  allocations       Allocation[]
  terminationRequests TerminationRequest[]
  maternityLeaveRequests MaternityLeaveRequest[]
  importRecords     ImportRecord[]
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  resources ResourceSkill[]
}

model ResourceSkill {
  id              String @id @default(uuid())
  resourceId      String
  skillId         String
  proficiency     Int    @default(3) // 1-5
  yearsExperience Float  @default(0)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([resourceId, skillId])
}

model Certification {
  id         String    @id @default(uuid())
  resourceId String
  name       String
  issuer     String?
  issueDate  DateTime?
  expiryDate DateTime?

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, name])
}

model PerformanceRecord {
  id           String   @id @default(uuid())
  resourceId   String
  rating       String // e.g. Exceeds / Meets / Below
  pipStatus    Boolean  @default(false)
  reviewDate   DateTime
  notes        String?
  createdAt    DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

// ---------- Projects / Allocation ----------

model Project {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  portfolioId String
  billingDelayed Boolean    @default(false)
  isInternalProject Boolean @default(false)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?

  portfolio   Portfolio    @relation(fields: [portfolioId], references: [id])
  tasks       Task[]
  allocations Allocation[]
}

model DemandRequest {
  id                 String      @id @default(uuid())
  portfolioId        String
  projectName        String
  projectCode        String?
  clientName         String?
  roleName           String
  location           String?
  requiredSkills     String[]
  minProficiency     Int?
  minExperienceYears Float?
  requiredCertifications String[]
  requiredFte        Decimal     @db.Decimal(5, 2)
  startDate          DateTime
  endDate            DateTime?
  status             DemandStage @default(DRAFT)
  confidenceStage    DemandStage @default(DRAFT)
  ownerId            String
  createdById        String
  updatedById        String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id])
  owner     User      @relation("DemandOwner", fields: [ownerId], references: [id])
  createdBy User      @relation("DemandCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("DemandUpdatedBy", fields: [updatedById], references: [id])
  document  DemandDocument?
}

model DemandDocument {
  demandRequestId String   @id
  fileName        String
  mimeType        String
  fileSize        Int
  data            Bytes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  demandRequest DemandRequest @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(uuid())
  projectId String
  name      String
  startDate DateTime
  endDate   DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations Allocation[]
}

model Allocation {
  id                 String           @id @default(uuid())
  resourceId         String
  projectId          String
  taskId             String?
  portfolioId        String
  allocationPercent  Int
  roleOnProject      String?
  projectReportingManagerName String?
  startDate          DateTime
  endDate            DateTime?
  status             AllocationStatus @default(SCHEDULED)
  createdById        String
  notes              String?
  reallocatedFromId  String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  resource        Resource    @relation(fields: [resourceId], references: [id])
  project         Project     @relation(fields: [projectId], references: [id])
  task            Task?       @relation(fields: [taskId], references: [id])
  portfolio       Portfolio   @relation(fields: [portfolioId], references: [id], name: "AllocationPortfolio")
  createdBy       User        @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  reallocatedFrom Allocation? @relation("ReallocationChain", fields: [reallocatedFromId], references: [id])
  reallocatedTo   Allocation? @relation("ReallocationChain")
}

// ---------- Bench config ----------

model BenchConfig {
  id                          String     @id @default(uuid())
  portfolioId                 String?    @unique
  committedWindowDays         Int        @default(14)
  trueBenchAgingThresholdDays Int        @default(30)

  portfolio Portfolio? @relation(fields: [portfolioId], references: [id])
}

// ---------- Termination ----------

model TerminationRequest {
  id             String            @id @default(uuid())
  resourceId     String
  initiatedById  String
  reasonCode     String
  reason         String?
  status         TerminationStatus @default(PENDING_HR_APPROVAL)
  hrApproverId   String?
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())

  resource    Resource @relation(fields: [resourceId], references: [id])
  initiatedBy User     @relation("TerminationInitiator", fields: [initiatedById], references: [id])
  hrApprover  User?    @relation("TerminationApprover", fields: [hrApproverId], references: [id])
}

model MaternityLeaveRequest {
  id             String         @id @default(uuid())
  resourceId     String
  initiatedById  String
  reason         String?
  status         ApprovalStatus @default(PENDING_HR_APPROVAL)
  hrApproverId   String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  resource    Resource @relation(fields: [resourceId], references: [id])
  initiatedBy User     @relation("MlInitiator", fields: [initiatedById], references: [id])
  hrApprover  User?    @relation("MlApprover", fields: [hrApproverId], references: [id])
}

// ---------- Import / Sync ----------

model ImportBatch {
  id               String            @id @default(uuid())
  source           String // HRMIS or MANUAL
  status           ImportBatchStatus @default(RUNNING)
  createdCount     Int               @default(0)
  updatedCount     Int               @default(0)
  quarantinedCount Int               @default(0)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?

  records ImportRecord[]
}

model ImportRecord {
  id         String             @id @default(uuid())
  batchId    String
  employeeId String
  rawData    Json
  status     ImportRecordStatus
  errors     Json?
  resourceId String?
  createdAt  DateTime           @default(now())

  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resource Resource?   @relation(fields: [resourceId], references: [id])
}

// ---------- Notifications & Audit ----------

model Notification {
  id                 String           @id @default(uuid())
  userId             String
  type               NotificationType
  message            String
  relatedEntityType  String?
  relatedEntityId    String?
  read               Boolean          @default(false)
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  portfolioId String?
  before      Json?
  after       Json?
  reason      String?
  success     Boolean  @default(true)
  message     String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}
